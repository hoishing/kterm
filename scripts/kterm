#!/bin/bash
# Talk to a running kterm. The app writes the port and token to
# ~/Library/Application Support/kterm/endpoint.json
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  kterm tab list
  kterm tab new --agent claude|codex|pi|grok|shell [--cwd DIR] [--prompt TEXT]
  kterm tab focus --id UUID
  kterm tab send --id UUID [--text TEXT] [--enter]
  kterm tab read --id UUID
EOF
}

if [[ $# -lt 2 || "$1" != "tab" ]]; then
  usage >&2
  exit 1
fi
action="$2"
shift 2

agent=""
cwd=""
prompt=""
id=""
text=""
enter=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent) agent="${2:-}"; shift 2 ;;
    --cwd) cwd="${2:-}"; shift 2 ;;
    --prompt) prompt="${2:-}"; shift 2 ;;
    --id) id="${2:-}"; shift 2 ;;
    --text) text="${2:-}"; shift 2 ;;
    --enter) enter=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

json_string() {
  osascript -l JavaScript -e 'function run(argv) { return JSON.stringify(argv[0]); }' -- "$1"
}

endpoint="${HOME}/Library/Application Support/kterm/endpoint.json"
if [[ ! -f "$endpoint" ]]; then
  echo "kterm is not running (no endpoint file)" >&2
  exit 1
fi
port=$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$endpoint" | head -n 1)
token=$(sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$endpoint" | head -n 1)
if [[ -z "$port" || -z "$token" ]]; then
  echo "kterm endpoint file is unreadable" >&2
  exit 1
fi

base="http://127.0.0.1:${port}"
auth=("Authorization: Bearer ${token}")

request() {
  local method="$1" url="$2" body="${3:-}"
  local tmp
  tmp=$(mktemp)
  local code
  if [[ -n "$body" ]]; then
    code=$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" \
      -H "${auth[0]}" -H 'Content-Type: application/json' \
      --data-binary "$body" "$url") || { rm -f "$tmp"; echo "kterm is not reachable" >&2; exit 1; }
  else
    code=$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" \
      -H "${auth[0]}" "$url") || { rm -f "$tmp"; echo "kterm is not reachable" >&2; exit 1; }
  fi
  cat "$tmp"
  echo
  rm -f "$tmp"
  if [[ "$code" != "200" ]]; then
    exit 1
  fi
}

case "$action" in
  list)
    request GET "${base}/tabs"
    ;;
  new)
    if [[ -z "$agent" ]]; then
      echo "--agent is required" >&2
      exit 1
    fi
    body="{\"agent\":$(json_string "$agent")}"
    if [[ -n "$cwd" ]]; then
      body="${body%\}},\"cwd\":$(json_string "$cwd")}"
    fi
    if [[ -n "$prompt" ]]; then
      body="${body%\}},\"prompt\":$(json_string "$prompt")}"
    fi
    request POST "${base}/tabs" "$body"
    ;;
  focus)
    [[ -n "$id" ]] || { echo "--id is required" >&2; exit 1; }
    request POST "${base}/tabs/${id}/focus" '{}'
    ;;
  send)
    [[ -n "$id" ]] || { echo "--id is required" >&2; exit 1; }
    body="{\"text\":$(json_string "$text"),\"enter\":${enter}}"
    request POST "${base}/tabs/${id}/send" "$body"
    ;;
  read)
    [[ -n "$id" ]] || { echo "--id is required" >&2; exit 1; }
    request GET "${base}/tabs/${id}/read"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
