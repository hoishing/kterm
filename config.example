# kterm configuration — copy to ~/.config/kterm/config
#
# Syntax is `key = value`. Lines starting with `kterm-` configure the app shell;
# every other key is passed straight to libghostty, so any standard Ghostty
# setting works here (font-family, font-size, theme, background, cursor-style,
# command, ...). See https://ghostty.org/docs/config for the full list.

# --- app shell (kterm-only) ---
kterm-sidebar-width = 160
# Where a new ⌘N/⌘T tab lands: after-current (default) or end
kterm-new-tab-position = after-current
# Programming ligatures are off by default; set to true to enable them
kterm-font-ligatures = false
# App-shell chrome font (sidebar, tabs, pills, …). Default shown; falls back
# to the system UI font when the family isn't installed. `monospace` = system mono.
# kterm-ui-font-family = JetBrainsMono Nerd Font Mono

# --- terminal (libghostty) ---
# kterm built-in defaults (override by setting the same key here):
#   macos-option-as-alt = left
#   copy-on-select = clipboard
#   theme = Ghostty Default Style Dark   (bundled; more at ghostty.org/docs)
#   font-family = JetBrainsMono Nerd Font Mono
# font-family = Menlo
font-size = 13
cursor-style = block
# command = /bin/zsh
